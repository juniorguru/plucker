1-1.fna.fbcdn.net\u0026_nc_cat=106\u0026_nc_oc=Q6cZ2gF9R6wM4oSBva9IUjb0TJ-vMjwKjhpICHnJXgXXjmgtfJuSmm5lJeCZ-c9XX1Xh3vE\u0026_nc_ohc=CG2bh-5LuVgQ7kNvwHOOnvA\u0026_nc_gid=R9BuYUgUiqybe-tKdNTLGg\u0026edm=AOQ1c0wBAAAA\u0026ccb=7-5\u0026oh=00_Af_PEOUdFEID3r-EJxBn18mxLkvoNwOEKNf9NCqyjK6kAw\u0026oe=6A2EF296\u0026_nc_sid=8b3546","edge_media_to_tagged_user":{"edges":[{"node":{"user":{"full_name":"Honza Javorek","followed_by_viewer":false,"id":"5069518320","is_verified":false,"profile_pic_url":"https://instagram.fbrq1-1.fna.fbcdn.net/v/t51.82787-19/582807918_18319925257174321_7116587626955346232_n.jpg?stp=dst-jpg_s150x150_tt6\u0026efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDY4LmMyIn0\u0026_nc_ht=instagram.fbrq1-1.fna.fbcdn.net\u0026_nc_cat=101\u0026_nc_oc=Q6cZ2gF9R6wM4oSBva9IUjb0TJ-vMjwKjhpICHnJXgXXjmgtfJuSmm5lJeCZ-c9XX1Xh3vE\u0026_nc_ohc=_XvKe5ZQ4lEQ7kNvwES-sBn\u0026_nc_gid=R9BuYUgUiqybe-tKdNTLGg\u0026edm=AOQ1c0wBAAAA\u0026ccb=7-5\u0026oh=00_Af8Jxsz9zki4XnwJ_tmFal4tLmCD1QEsHcixBlvgIRWAhQ\u0026oe=6A2EF4AE\u0026_nc_sid=8b3546","username":"honza.javorek"},"x":0.5,"y":0.5}}]},"fact_check_overall_rating":null,"fact_check_information":null,"gating_info":null,"sharing_friction_info":{"should_have_sharing_friction":false,"bloks_app_url":null},"media_overlay_info":null,"media_preview":"","owner":{"id":"5918124215","username":"zeleni.praha3"},"is_video":false,"has_upcoming_event":false,"accessibility_caption":null,"edge_media_to_caption":{"edges":[{"node":{"text":"Další, kdo nás podpořil svou kandidaturou, je Honza Javorek 🥳\n \nProč se Honza rozhodl být na zelené kandidátce? 🤓\n“Chci ulice, kde se neusmažím horkem, kde v pohodě projedu s kočárkem a kde najdu pítko nebo záchod. Chci přecházet silnici nebo posílat dítě samo do školy a nebát se. Chci nové byty, aby lidé mohli bydlet v Praze a měli většinu věcí za rohem jako já, místo aby dvakrát denně stáli pod mými okny v zácpách. A kandiduji, protože chtít nestačí. ☝️\n\nZelení byli na Praze 3 v koalici na radnici poslední 4 roky a moc se mi líbí, co tady prosazují. Toto je můj způsob, jak je můžu podpořit víc, než jen hlasem nebo lajkem na FB. \nPatnácté nebo kolikáté místo na kandidátce samozřejmě znamená, že nemám reálnou šanci být někam zvolen, ale budu rád, když třeba i díky mě dostanou místní Zelení nějaké hlasy.” 💚\n\nHonza dřív pracoval jako programátor, dnes má vlastní internetový projekt: https://juniorguru.cz Tam sepisuje veřejně dostupné návody pro všechny, kdo by chtěli začít s programováním a případně si plánovali najít práci v IT, ať už jde o mámy na rodičovské, novináře, vědkyně, nebo puberťáky. 🤗\n\nV souvislosti s projektem si Honzu zvou jako hosta do podcastů a publikoval díky tomu i pro Hospodářské noviny, Heroine.cz, nebo Czechcrunch. 15 let si píše osobní blog, kde vydává týdenní poznámky ze zákulisí svého podnikání. Je velkým fanouškem transparentnosti a snaží se podnikat udržitelně, tedy vydělat tak akorát na nájem a provoz rodiny. \n\nV Praze žije 8 let, postupně na Křížkovského, Koněvově, Lupáčově. Žižkov si zamiloval. Auto díky tomu zatím nepotřeboval, nejraději chodí po městě pěšky, v posledním roce s kočárkem. Zajímá se o dění ve své čtvrti, veřejný prostor, urbanismus. 🙃\n\n👉 Prohlédněte si celou naši kandidátku, link v biu. A o víkendu volte Zelené!\n\n#zeleni #volby #zizkov #jarov #vinohrady #komunalnivolby #ctvrtkterouchces"}}]},"edge_media_to_comment":{"count":2},"comments_disabled":false,"taken_at_timestamp":1663750455,"edge_liked_by":{"count":10},"edge_media_preview_like":{"count":10},"location":{"id":"216456769","has_public_page":true,"name":"Praha 3","slug":"praha-3"},"nft_asset_info":null,"thumbnail_src":"https://instagram.fbrq1-1.fna.fbcdn.net/v/t51.82787-15/625960973_18300138910279722_8189519752572388327_n.jpg?stp=dst-jpg_e35_s640x640_sh2.08_tt6\u0026_nc_ht=instagram.fbrq1-1.fna.fbcdn.net\u0026_nc_cat=106\u0026_nc_oc=Q6cZ2gF9R6wM4oSBva9IUjb0TJ-vMjwKjhpICHnJXgXXjmgtfJuSmm5lJeCZ-c9XX1Xh3vE\u0026_nc_ohc=CG2bh-5LuVgQ7kNvwHOOnvA\u0026_nc_gid=R9BuYUgU